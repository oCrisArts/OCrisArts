{
 "$schema":"https://openapi.vercel.sh/vercel.json",
 "framework":"vite",
 "buildCommand":"npm run build",
 "installCommand":"pnpm install --frozen-lockfile",
 "outputDirectory":"dist",
 "cleanUrls":true,
 "trailingSlash":false,
 "redirects":[{"source":"/:path*","has":[{"type":"host","value":"www.ocris.art.br"}],"destination":"https://ocris.art.br/:path*","permanent":true}],
 "headers":[
  {"source":"/:path*","missing":[{"type":"host","value":"ocris.art.br"}],"headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"}]},
  {"source":"/:path*","headers":[{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"X-Content-Type-Options","value":"nosniff"}]}
 ]
}
