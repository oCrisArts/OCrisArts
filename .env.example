# Indexing is enabled only when all three conditions match at build time.
# Set this in Vercel Project Settings too, so installation uses packageManager from package.json.
ENABLE_EXPERIMENTAL_COREPACK=1
VITE_SITE_URL=https://ocris.art.br
VITE_ENABLE_INDEXING=false
# Vercel supplies VERCEL_ENV automatically. Do not override it in Preview.
# VERCEL_ENV=production
# Enable only in a dedicated debugging deployment, never by default.
VITE_ANALYTICS_DEBUG=false

# Prospecting: use a publishable key only. Never expose service_role/secret keys.
VITE_SUPABASE_URL=https://oepbbkdfcktpkvqojsjx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Show the 12-hour promise only after operational confirmation.
VITE_PROPOSAL_SLA_GUARANTEED=false
VITE_PROPOSAL_SLA_HOURS=12

# Edge Function secrets (configure with `supabase secrets set`, not in Vite):
# ALLOWED_ORIGINS=https://ocris.art.br
# LEAD_FINGERPRINT_SALT=<long-random-secret>
# TURNSTILE_SECRET_KEY=<optional>
